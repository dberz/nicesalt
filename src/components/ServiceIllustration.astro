---
/**
 * Service icons: one story per icon, told with the minimum cast.
 * one focal crystal, one support shape, one connector, one coral accent.
 * Geometry and palette per docs/illustration-style.md.
 */
type Kind =
  | "strategy" | "product" | "content" | "conversion" | "analytics"
  | "ai" | "webapp" | "publishing" | "teardown";

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;

// The brand crystal, built from its canonical geometry (docs/illustration-style.md):
// a rhombus on its point, width = 0.72 x height, four flat facets
// (pale / teal / blue / stone, clockwise from top-left), paper seams, faint ink outline.
const n = (v: number) => Math.round(v * 10) / 10;
const crystal = (cx: number, cy: number, h: number) => {
  const w = h * 0.36;
  const [t, b, l, r] = [n(cy - h / 2), n(cy + h / 2), n(cx - w), n(cx + w)];
  return {
    facets: [
      { tone: "pale", d: `M${cx} ${t} L${l} ${cy} L${cx} ${cy} Z` },
      { tone: "teal", d: `M${cx} ${t} L${r} ${cy} L${cx} ${cy} Z` },
      { tone: "blue", d: `M${cx} ${b} L${r} ${cy} L${cx} ${cy} Z` },
      { tone: "stone", d: `M${cx} ${b} L${l} ${cy} L${cx} ${cy} Z` }
    ],
    seam: `M${cx} ${t}V${b}M${l} ${cy}H${r}`,
    outline: `M${cx} ${t} L${r} ${cy} L${cx} ${b} L${l} ${cy} Z`
  };
};
// A supporting grain: same rhombus, one tone, paper cross-seams.
const grain = (cx: number, cy: number, h: number) => {
  const w = h * 0.36;
  const [t, b, l, r] = [n(cy - h / 2), n(cy + h / 2), n(cx - w), n(cx + w)];
  return { body: `M${cx} ${t} L${r} ${cy} L${cx} ${b} L${l} ${cy} Z`, seam: `M${cx} ${t}V${b}M${l} ${cy}H${r}` };
};

const aiCrystal = crystal(104, 75, 60);
const webCrystal = crystal(130, 76, 50);
const pubCrystal = crystal(196, 78, 44);
const pubTop = grain(196, 34, 26);
const pubBottom = grain(196, 122, 26);
const tdCrystal = crystal(84, 64, 46);
---

<figure class:list={["service-illustration", `service-illustration--${kind}`]} aria-hidden="true">
  {kind === "strategy" && (
    <!-- Saying one thing, to one audience, on purpose: a shot at the centre. -->
    <svg viewBox="0 0 260 150" fill="none">
      <circle class="si-line muted" cx="168" cy="75" r="47" />
      <circle class="si-line muted" cx="168" cy="75" r="29" />
      <path class="si-path" d="M26 130c34-8 62-21 86-36" />
      <path class="si-plane coral" d="M114 93l18-9-3 14z" />
      <g class="si-crystal si-crystal--full">
        <path class="si-crystal-facet pale" d="M168 49 L149.3 75 L168 75 Z" />
        <path class="si-crystal-facet teal" d="M168 49 L186.7 75 L168 75 Z" />
        <path class="si-crystal-facet blue" d="M168 101 L186.7 75 L168 75 Z" />
        <path class="si-crystal-facet stone" d="M168 101 L149.3 75 L168 75 Z" />
        <path class="si-crystal-seam" d="M168 49V101M149.3 75H186.7" />
        <path class="si-crystal-outline" d="M168 49 L186.7 75 L168 101 L149.3 75 Z" />
      </g>
    </svg>
  )}

  {kind === "product" && (
    <!-- Not a page: a working thing with a play button in it. -->
    <svg viewBox="0 0 260 150" fill="none">
      <rect class="si-card" x="50" y="18" width="78" height="114" rx="14" />
      <path class="si-block teal" d="M66 38h36v11H66z" />
      <path class="si-line" d="M66 62h46" />
      <rect class="si-panel" x="66" y="78" width="46" height="32" rx="7" />
      <path class="si-plane coral" d="M84 87l15 7-15 7z" />
      <path class="si-path" d="M128 75h38" />
      <g class="si-crystal si-crystal--full">
        <path class="si-crystal-facet pale" d="M192 49 L173.3 75 L192 75 Z" />
        <path class="si-crystal-facet teal" d="M192 49 L210.7 75 L192 75 Z" />
        <path class="si-crystal-facet blue" d="M192 101 L210.7 75 L192 75 Z" />
        <path class="si-crystal-facet stone" d="M192 101 L173.3 75 L192 75 Z" />
        <path class="si-crystal-seam" d="M192 49V101M173.3 75H210.7" />
        <path class="si-crystal-outline" d="M192 49 L210.7 75 L192 101 L173.3 75 Z" />
      </g>
    </svg>
  )}

  {kind === "content" && (
    <!-- One article, distributed: a source panel fanning into grains. -->
    <svg viewBox="0 0 260 150" fill="none">
      <rect class="si-panel" x="28" y="44" width="82" height="62" rx="10" />
      <path class="si-block teal" d="M42 58h24v16H42z" />
      <path class="si-line" d="M42 90h52" />
      <path class="si-path" d="M110 62c28-12 46-18 66-21M110 75h70M110 88c28 12 46 18 64 21" />
      <path class="si-plane coral" d="M150 70l11 5-11 5z" />
      <g class="si-grain">
        <path class="si-crystal-tone teal" d="M188 40 L195.2 50 L188 60 L180.8 50 Z" />
        <path class="si-crystal-seam" d="M188 40V60M180.8 50H195.2" />
      </g>
      <g class="si-grain">
        <path class="si-crystal-tone blue" d="M194 63 L202.6 75 L194 87 L185.4 75 Z" />
        <path class="si-crystal-seam" d="M194 63V87M185.4 75H202.6" />
      </g>
      <g class="si-grain">
        <path class="si-crystal-tone stone" d="M186 101 L192.5 110 L186 119 L179.5 110 Z" />
        <path class="si-crystal-seam" d="M186 101V119M179.5 110H192.5" />
      </g>
    </svg>
  )}

  {kind === "conversion" && (
    <!-- Wide attention in, one crystal out. -->
    <svg viewBox="0 0 260 150" fill="none">
      <path class="si-plane teal" d="M44 30h60v46h-20z" />
      <path class="si-plane blue" d="M104 30h60l-40 46h-20z" />
      <path class="si-plane pale" d="M96 76h16v10H96z" />
      <path class="si-plane coral" d="M100 92l4 7 4-7z" />
      <g class="si-crystal si-crystal--full">
        <path class="si-crystal-facet pale" d="M104 104 L93.9 118 L104 118 Z" />
        <path class="si-crystal-facet teal" d="M104 104 L114.1 118 L104 118 Z" />
        <path class="si-crystal-facet blue" d="M104 132 L114.1 118 L104 118 Z" />
        <path class="si-crystal-facet stone" d="M104 132 L93.9 118 L104 118 Z" />
        <path class="si-crystal-seam" d="M104 104V132M93.9 118H114.1" />
        <path class="si-crystal-outline" d="M104 104 L114.1 118 L104 132 L93.9 118 Z" />
      </g>
      <path class="si-line muted" d="M70 140h68" />
    </svg>
  )}

  {kind === "analytics" && (
    <!-- Bars measure; the trend line grows a grain. -->
    <svg viewBox="0 0 260 150" fill="none">
      <path class="si-line muted" d="M40 122h180" />
      <path class="si-block teal" d="M62 92h22v30H62z" />
      <path class="si-block blue" d="M100 74h22v48h-22z" />
      <path class="si-block stone" d="M138 54h22v68h-22z" />
      <path class="si-path" d="M73 82c31-18 66-34 100-46" />
      <g class="si-grain">
        <path class="si-crystal-tone teal" d="M184 21 L191.2 31 L184 41 L176.8 31 Z" />
        <path class="si-crystal-seam" d="M184 21V41M176.8 31H191.2" />
      </g>
      <path class="si-plane coral" d="M198 24l14-8-2 13z" />
    </svg>
  )}

  {kind === "ai" && (
    <!-- An agent working a loop over your tools and data, then handing its output to a person. The coral check is the human review. -->
    <svg viewBox="0 0 260 150" fill="none">
      <circle class="si-path" cx="104" cy="75" r="50" />
      <circle class="si-node teal" cx="60.7" cy="50" r="5.5" />
      <circle class="si-node blue" cx="79" cy="118.3" r="5.5" />
      <g class="si-crystal si-crystal--full">
        {aiCrystal.facets.map((f) => <path class={`si-crystal-facet ${f.tone}`} d={f.d} />)}
        <path class="si-crystal-seam" d={aiCrystal.seam} />
        <path class="si-crystal-outline" d={aiCrystal.outline} />
      </g>
      <path class="si-path" d="M164 75H190" />
      <rect class="si-card" x="192" y="46" width="46" height="58" rx="9" />
      <path class="si-line" d="M202 62h26M202 74h18M202 86h22" />
      <circle class="si-node coral" cx="154" cy="75" r="9" />
      <path class="si-tick" d="M149.6 75.4l3 3 5.8-6.4" />
    </svg>
  )}

  {kind === "webapp" && (
    <!-- A customer-facing portal and an internal tool, joined by the product logic at the centre. The coral cursor is someone using it. -->
    <svg viewBox="0 0 260 150" fill="none">
      <rect class="si-card" x="16" y="28" width="66" height="72" rx="10" />
      <path class="si-block teal" d="M27 39h28v11H27z" />
      <path class="si-line" d="M27 64h42M27 77h30" />
      <path class="si-path" d="M86 64c12 0 12 12 22 12M152 76c10 0 10 12 22 12" />
      <g class="si-crystal si-crystal--full">
        {webCrystal.facets.map((f) => <path class={`si-crystal-facet ${f.tone}`} d={f.d} />)}
        <path class="si-crystal-seam" d={webCrystal.seam} />
        <path class="si-crystal-outline" d={webCrystal.outline} />
      </g>
      <rect class="si-card" x="178" y="52" width="66" height="72" rx="10" />
      <path class="si-block blue" d="M187 61h12v54h-12z" />
      <path class="si-line" d="M207 71h26M207 84h18" />
      <rect class="si-block stone" x="207" y="98" width="24" height="11" rx="4" />
      <path class="si-plane coral" d="M222 101v15l3.8-3.4 2.8 6.3 2.7-1.2-2.8-6.2 5.1-.2z" />
    </svg>
  )}

  {kind === "publishing" && (
    <!-- One article becomes a page, an email, and a post. The full crystal is the page; the coral arrow is the reader moving toward it. -->
    <svg viewBox="0 0 260 150" fill="none">
      <rect class="si-card" x="24" y="28" width="78" height="96" rx="10" />
      <path class="si-block teal" d="M35 39h56v27H35z" />
      <path class="si-line" d="M35 81h50M35 94h38M35 107h44" />
      <path class="si-path" d="M106 66c30-16 52-28 80-32M106 78h72M106 90c30 16 52 28 80 32" />
      <path class="si-plane coral" d="M142 73l11 5-11 5z" />
      <g class="si-grain">
        <path class="si-crystal-tone teal" d={pubTop.body} />
        <path class="si-crystal-seam" d={pubTop.seam} />
      </g>
      <g class="si-crystal si-crystal--full">
        {pubCrystal.facets.map((f) => <path class={`si-crystal-facet ${f.tone}`} d={f.d} />)}
        <path class="si-crystal-seam" d={pubCrystal.seam} />
        <path class="si-crystal-outline" d={pubCrystal.outline} />
      </g>
      <g class="si-grain">
        <path class="si-crystal-tone stone" d={pubBottom.body} />
        <path class="si-crystal-seam" d={pubBottom.seam} />
      </g>
    </svg>
  )}

  {kind === "teardown" && (
    <!-- A close read: the crystal under a lens. The coral spark is the finding. -->
    <svg viewBox="38 6 112 118" fill="none">
      <path class="si-handle" d="M112 92l26 26" />
      <circle class="si-lens" cx="84" cy="64" r="38" />
      <g class="si-crystal si-crystal--full">
        {tdCrystal.facets.map((f) => <path class={`si-crystal-facet ${f.tone}`} d={f.d} />)}
        <path class="si-crystal-seam" d={tdCrystal.seam} />
        <path class="si-crystal-outline" d={tdCrystal.outline} />
      </g>
      <path class="si-plane coral" d="M132 14l3 8.5 8.5 3-8.5 3-3 8.5-3-8.5-8.5-3 8.5-3z" />
    </svg>
  )}
</figure>
