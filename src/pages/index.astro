---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectMedia from "../components/ProjectMedia.astro";
import ServiceIllustration from "../components/ServiceIllustration.astro";
import { SITE, caseStudies } from "../data/site";

const capabilities = [
  { id: "ai", title: "AI products", text: "An assistant or agent that works with your real data, with a person checking the work where it matters.", art: "ai" },
  { id: "web", title: "Web apps", text: "Customer portals and internal tools that make everyday work easier for your team and your customers.", art: "webapp" },
  { id: "publishing", title: "Publishing platforms", text: "A site and newsletter that turn each thing you write into a page, an email, and new subscribers.", art: "publishing" }
] as const;
const caseOrder = ["robinberzinmd", "bibo", "explorer-health"];
const pilotCaseStudies = [...caseStudies].sort((a, b) => caseOrder.indexOf(a.slug) - caseOrder.indexOf(b.slug)).map((study) => {
  if (study.slug === "bibo") return { ...study, label: "AI-native media concept", summary: "A clickable demo of one classic becoming five listenable versions: shortened, genre-shifted, translated, and re-narrated." };
  if (study.slug === "explorer-health") return { ...study, label: "AI-assisted health product", summary: "A private assessment that turns a sensitive health question into a plain-language recovery profile and a clear next step." };
  return study;
});
const formConfigured = Boolean(SITE.formAccessKey);
const formAction = formConfigured ? SITE.formAction : `mailto:${SITE.email}`;
const formMethod = formConfigured ? "POST" : "GET";
const bookingConfigured = Boolean(SITE.bookingUrl);
---

<BaseLayout pilot title="A small studio for AI products and publishing platforms" description="NiceSalt is a small studio that turns AI ideas into working products, built on the right data from day one.">
  <section class="hero" data-hero-field>
    <div class="hero-copy">
      <p class="kicker">From vibes to viability</p>
      <h1>You bring the idea. We help you build it.</h1>
      <p class="lede">A small studio that turns AI ideas into working products, built on the right data from day one.</p>
      <div class="hero-actions" data-analytics-component="home_hero" data-analytics-event="cta">
        <a class="button primary" href="#work">See the work</a>
        <a class="button ghost" href="#contact">Get in touch</a>
      </div>
    </div>
    <canvas class="hero-salt-field" data-hero-salt aria-hidden="true"></canvas>
  </section>

  <section class="offers-section" aria-labelledby="offers-title">
    <div class="section-heading compact">
      <p class="kicker">What we do</p>
      <h2 id="offers-title">Where we can help.</h2>
    </div>
    <div class="offers-band" aria-label="Where we can help">
      {capabilities.map((offer) => (
        <article data-reveal>
          <div class="capability-art" aria-hidden="true">
            <ServiceIllustration kind={offer.art} />
          </div>
          <strong>{offer.title}</strong>
          <span>{offer.text}</span>
        </article>
      ))}
    </div>
    <p class="data-advantage-brief"><strong>And underneath all of it, your data.</strong> We set it up so you can see what's working and decide what to do next.</p>
  </section>

  <section class="work-section" id="work" aria-label="Recent work">
    <div class="section-heading compact">
      <h2>Recent work</h2>
    </div>
    <div class="work-list" data-analytics-component="home_selected_work" data-analytics-event="recirculation">
      {pilotCaseStudies.map((study) => (
        <article class="work-row" data-reveal>
          <ProjectMedia study={study} href={`/case-studies/${study.slug}/`} class="work-image" />
          <div>
            <p class="kicker">{study.label}</p>
            <h3><a href={`/case-studies/${study.slug}/`}>{study.name}</a></h3>
            <p>{study.summary}</p>
            <a class="text-link" href={`/case-studies/${study.slug}/`}>Read the case study</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="principal-section principal-solo" id="who" aria-labelledby="principal-title" data-reveal>
    <div class="principal-copy">
      <p class="kicker">About</p>
      <h2 id="principal-title">You'll work with David.</h2>
      <p>{SITE.principal.bio}</p>
      <p
        class="principal-links"
        data-analytics-component="home_principal"
        data-analytics-event="navigation"
      >
        <a class="text-link" href={SITE.principal.url} rel="me">Background</a>
      </p>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="section-heading">
      <p class="kicker">Contact</p>
      <h2 id="contact-title">Tell us what you're working on.</h2>
      <p>We take on a small number of projects, mostly through people we know. If someone sent you, tell us who. A few sentences about what you're trying to do is plenty.</p>
      {bookingConfigured && (
        <p class="contact-direct" data-analytics-component="contact_booking" data-analytics-event="cta">
          Rather skip the form?
          <a class="button ghost small" href={SITE.bookingUrl} rel="noopener" target="_blank">Book 30 minutes</a>
        </p>
      )}
    </div>
    <form class="contact-form" action={formAction} method={formMethod} data-inquiry-form data-form-name="contact" data-success-url={`${SITE.url}/thanks/`} data-form-configured={formConfigured ? "true" : "false"}>
      <input type="hidden" name="access_key" value={SITE.formAccessKey} />
      <input type="hidden" name="subject" value="NiceSalt project inquiry" />
      <input type="hidden" name="from_name" value="NiceSalt.com" />
      <input type="hidden" name="redirect" value={`${SITE.url}/thanks/`} />
      <input type="hidden" name="engagement" value="" />
      <input class="form-honey" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        <span>Company or project</span>
        <input name="company" autocomplete="organization" />
      </label>
      <label>
        <span>What needs to get unstuck?</span>
        <select name="project_type" data-project-type required>
          <option value="" selected disabled>Select a project type</option>
          {capabilities.map((offer) => (
            <option value={offer.title}>{offer.title}</option>
          ))}
          <option value="Other product work">Not sure yet</option>
        </select>
      </label>
      <label class="wide">
        <span>Budget or timeline, if useful</span>
        <input name="budget_timeline" />
      </label>
      <label class="wide">
        <span>What's going on?</span>
        <textarea name="message" rows="6" data-message required></textarea>
      </label>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      <button class="button primary" type="submit">Send inquiry</button>
    </form>
  </section>
</BaseLayout>
