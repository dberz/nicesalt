---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectMedia from "../components/ProjectMedia.astro";
import ServiceIllustration from "../components/ServiceIllustration.astro";
import { SITE, caseStudies, credentials, engagements, faqs, nextMoves, offers } from "../data/site";

const offerGlyphs = ["strategy", "product", "content", "analytics"] as const;
const formConfigured = Boolean(SITE.formAccessKey);
const formAction = formConfigured ? SITE.formAction : `mailto:${SITE.email}`;
const formMethod = formConfigured ? "POST" : "GET";
const bookingConfigured = Boolean(SITE.bookingUrl);
---

<BaseLayout>
  <section class="hero" data-hero-field>
    <div class="hero-copy">
      <p class="kicker">For founders, experts, and ambitious teams</p>
      <h1>A small studio with great taste.</h1>
      <p class="lede">
        Production got cheap. Judgment didn't. Anyone can ship a decent site
        or a passable prototype in a weekend. Knowing what to build, what to
        say, and what to measure is the part that's still hard.
      </p>
      <div class="hero-actions" data-analytics-component="home_hero" data-analytics-event="cta">
        <a class="button primary" href="/free-teardown/">Get a free teardown</a>
        <a class="button ghost" href="/case-studies/">See selected work</a>
      </div>
    </div>
    <canvas class="hero-salt-field" data-hero-salt aria-hidden="true"></canvas>
  </section>

  <section class="offers-section" aria-labelledby="offers-title">
    <div class="section-heading compact">
      <p class="kicker">What we do</p>
      <h2 id="offers-title">Four disciplines. One system.</h2>
    </div>
    <div class="offers-band" aria-label="What we work across" data-analytics-component="home_offers" data-analytics-event="cta">
      {offers.map((offer, index) => (
        <a href="#next" data-reveal>
          <ServiceIllustration kind={offerGlyphs[index]} />
          <strong>{offer.title}</strong>
          <span>{offer.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="principal-section" id="who" aria-labelledby="principal-title" data-reveal>
    <div class="principal-copy">
      <p class="kicker">Who you're working with</p>
      <h2 id="principal-title">You get the senior person, not a pitch team.</h2>
      <p>{SITE.principal.bio}</p>
      <p>{SITE.principal.bioSecond}</p>
      <p
        class="principal-links"
        data-analytics-component="home_principal"
        data-analytics-event="navigation"
      >
        <a class="text-link" href={SITE.principal.url} rel="me">Full background</a>
        <a class="text-link" href={SITE.principal.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      </p>
    </div>
    <ul class="credential-grid" aria-label="Selected results">
      {credentials.map((item) => (
        <li>
          <strong>{item.stat}</strong>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="engage-section" id="engagements" aria-labelledby="engage-title">
    <div class="section-heading">
      <p class="kicker">How it works</p>
      <h2 id="engage-title">Three ways to start.</h2>
      <p>
        Prices are real starting points, not a range that moves once you
        ask. If the numbers don't fit, say so in your note and we'll be
        honest about whether it's worth a call.
      </p>
    </div>
    <div class="engage-grid" data-analytics-component="home_engagements" data-analytics-event="cta">
      {engagements.map((item) => (
        <article class={item.featured ? "engage-card featured" : "engage-card"} data-reveal>
          {item.featured && <p class="engage-flag">Most projects start here</p>}
          <h3>{item.title}</h3>
          <p class="engage-price">{item.price}</p>
          <p class="engage-meta">{item.meta}</p>
          <p class="engage-text">{item.text}</p>
          <a
            class={item.featured ? "button primary small" : "button ghost small"}
            href={item.href}
            data-engagement={item.projectType}
            data-message={`I'm interested in: ${item.title}.`}
          >{item.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="system-section" id="system" aria-labelledby="system-title" data-reveal>
    <div class="system-copy">
      <p class="kicker">The approach</p>
      <h2 id="system-title">We run the whole loop.</h2>
      <p>
        Most teams buy positioning, product, content, and measurement as
        separate projects: a blog contractor here, a design freelancer there,
        an analytics dashboard nobody opens. We treat it as one loop. Each
        stage feeds the next, and nothing ships in isolation. It is the same
        loop whether the thing at the centre is a landing page or a platform.
      </p>
    </div>
    <figure class="loop-figure">
      <svg class="loop-diagram" viewBox="0 0 660 480" role="img" aria-label="A connected loop of four disciplines: positioning feeds product, product feeds content, content feeds measurement, and measurement informs positioning.">
        <defs>
          <marker id="loop-arrow" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M2 2 L10 6 L2 10 Z" />
          </marker>
        </defs>
        <circle class="loop-orbit" cx="330" cy="238" r="126" />
        <path class="loop-flow" d="M330 112 A126 126 0 1 1 329 112" />
        <g class="loop-runner">
          <path class="loop-runner-grain" d="M330 105 L335 112 L330 119 L325 112 Z" />
        </g>
        <g class="loop-hub">
          <path class="hub-plane pale" d="M330 184 L291 238 L330 238 Z" />
          <path class="hub-plane teal" d="M330 184 L369 238 L330 238 Z" />
          <path class="hub-plane blue" d="M330 292 L369 238 L330 238 Z" />
          <path class="hub-plane stone" d="M330 292 L291 238 L330 238 Z" />
          <path class="hub-seam" d="M330 184V292M291 238H369" />
          <path class="hub-outline" d="M330 184 L369 238 L330 292 L291 238 Z" />
        </g>
        <circle class="loop-hub-node teal" cx="356" cy="141" r="5" />
        <circle class="loop-hub-node blue" cx="401" cy="309" r="5" />
        <circle class="loop-hub-node stone" cx="233" cy="264" r="5" />
        <g class="loop-stage stage-positioning">
          <circle cx="330" cy="78" r="7" />
          <text x="330" y="44" text-anchor="middle">Positioning</text>
        </g>
        <g class="loop-stage stage-product">
          <circle cx="490" cy="238" r="7" />
          <text x="508" y="244">Product</text>
        </g>
        <g class="loop-stage stage-content">
          <circle cx="330" cy="398" r="7" />
          <text x="330" y="432" text-anchor="middle">Content</text>
        </g>
        <g class="loop-stage stage-measurement">
          <circle cx="170" cy="238" r="7" />
          <text x="152" y="244" text-anchor="end">Measurement</text>
        </g>
        <path class="loop-connector" d="M363.3 81.5 A160 160 0 0 1 486.5 204.7" marker-end="url(#loop-arrow)" />
        <path class="loop-connector" d="M486.5 271.3 A160 160 0 0 1 363.3 394.5" marker-end="url(#loop-arrow)" />
        <path class="loop-connector" d="M296.7 394.5 A160 160 0 0 1 173.5 271.3" marker-end="url(#loop-arrow)" />
        <path class="loop-connector" d="M173.5 204.7 A160 160 0 0 1 296.7 81.5" marker-end="url(#loop-arrow)" />
      </svg>
    </figure>
  </section>

  <section class="next-section" id="next" aria-labelledby="next-title">
    <div class="section-heading">
      <p class="kicker">Start here</p>
      <h2 id="next-title">Where are you stuck?</h2>
      <p>
        Most projects start as one of these four problems. Pick the closest.
        It gives your first note a useful starting point.
      </p>
    </div>
    <div class="next-grid" data-next-move data-analytics-component="home_next_move" data-analytics-event="cta">
      {nextMoves.map((item, index) => (
        <button
          class="next-choice"
          type="button"
          data-choice={item.id}
          data-project-type={item.projectType}
          data-message={`I'm interested in ${item.projectType}. ${item.text}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.title}</strong>
          <em>{item.text}</em>
        </button>
      ))}
    </div>
    <p class="next-followup" data-next-followup>
      <span>Sounds right?</span>
      <a class="text-link" href="#contact">Tell us about it</a>
    </p>
  </section>

  <section class="work-section" aria-label="Selected work">
    <div class="section-heading compact">
      <h2>Selected work</h2>
    </div>
    <div class="work-list" data-analytics-component="home_selected_work" data-analytics-event="recirculation">
      {caseStudies.map((study) => (
        <article class="work-row" data-reveal>
          <ProjectMedia study={study} href={`/case-studies/${study.slug}/`} class="work-image" />
          <div>
            <p class="kicker">{study.label}</p>
            <h3><a href={`/case-studies/${study.slug}/`}>{study.name}</a></h3>
            <p>{study.summary}</p>
            <a class="text-link" href={`/case-studies/${study.slug}/`}>Read the case study</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="notes-section" aria-labelledby="faq-title" data-reveal>
    <div class="section-heading compact">
      <p class="kicker">Good questions</p>
      <h2 id="faq-title">Before you write.</h2>
    </div>
    <div class="notes-list">
      {faqs.map((faq) => (
        <div class="note-row">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="section-heading">
      <p class="kicker">Contact</p>
      <h2 id="contact-title">Tell us what you're working on.</h2>
      <p>
        NiceSalt is independent project work by <a class="text-link inline" href={SITE.principal.url} rel="me">{SITE.principal.name}</a>.
        You work directly with the person making the decisions, and with
        specialists brought in when the scope earns them.
      </p>
      <ol class="how-it-starts">
        <li>
          <strong>A short note.</strong> A few sentences is plenty. Tell us
          what's bothering you and you'll hear back within two business days,
          usually with something useful already in it.
        </li>
        <li>
          <strong>A 30-minute call.</strong> We figure out what's actually
          broken and whether we're the right fit. No deck, no pitch.
        </li>
        <li>
          <strong>A first project.</strong> Most engagements start as a
          focused sprint, then grow into a full build or ongoing work if
          the results earn it.
        </li>
      </ol>
      {bookingConfigured && (
        <p class="contact-direct" data-analytics-component="contact_booking" data-analytics-event="cta">
          Rather skip the form?
          <a class="button ghost small" href={SITE.bookingUrl} rel="noopener" target="_blank">Book 30 minutes</a>
        </p>
      )}
    </div>
    <form class="contact-form" action={formAction} method={formMethod} data-inquiry-form data-form-name="contact" data-success-url={`${SITE.url}/thanks/`} data-form-configured={formConfigured ? "true" : "false"}>
      <input type="hidden" name="access_key" value={SITE.formAccessKey} />
      <input type="hidden" name="subject" value="NiceSalt project inquiry" />
      <input type="hidden" name="from_name" value="NiceSalt.com" />
      <input type="hidden" name="redirect" value={`${SITE.url}/thanks/`} />
      <input type="hidden" name="engagement" value="" />
      <input class="form-honey" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        <span>Company or project</span>
        <input name="company" autocomplete="organization" />
      </label>
      <label>
        <span>What needs to get unstuck?</span>
        <select name="project_type" data-project-type required>
          {offers.map((offer) => (
            <option value={offer.title}>{offer.title}</option>
          ))}
        </select>
      </label>
      <label class="wide">
        <span>Budget or timeline, if useful</span>
        <input name="budget_timeline" />
      </label>
      <label class="wide">
        <span>What's going on?</span>
        <textarea name="message" rows="6" data-message required></textarea>
      </label>
      <p class="form-status" data-form-status role="status" aria-live="polite">
        If the form gives you trouble, email <a class="text-link inline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <button class="button primary" type="submit">Send inquiry</button>
    </form>
  </section>
</BaseLayout>
